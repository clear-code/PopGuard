<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Build against the Win11 SDK to use the WinRT projection of FocusSessionManager (Windows.UI.Shell, Win11 22H2/22621+) -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <!-- Minimum supported OS is Windows 10 (focus sync only on 22621+, guarded at runtime by version) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WindowFilter</AssemblyName>
    <!-- Use WinForms for the system-tray residence (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The exe's own icon (shown in Explorer / taskbar) -->
    <ApplicationIcon>WindowFilter.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Embed the tray icons (active = green / inactive = gray) into the exe -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tray_active.ico" />
    <EmbeddedResource Include="Assets\tray_inactive.ico" />
  </ItemGroup>

</Project>
