<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Release publish of ToastTester (no .NET runtime required on the target).
  Visual Studio: right-click the project > Publish > this profile.
  CLI: dotnet publish ToastTester\ToastTester.csproj -p:PublishProfile=win-x64-selfcontained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- WinForms/WinRT depend on reflection, so trimming is left off to avoid runtime errors. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>bin\Release\net9.0-windows10.0.19041.0\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
